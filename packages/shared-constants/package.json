{
  "name": "@pierre/shared-constants",
  "version": "1.0.0",
  "description": "Shared constants for Pierre frontend applications (colors, labels, emojis)",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./notifications": {
      "types": "./src/notifications.ts",
      "import": "./src/notifications.ts"
    },
    "./onboarding": {
      "types": "./src/onboarding.ts",
      "import": "./src/onboarding.ts"
    },
    "./coaches": {
      "types": "./src/coaches.ts",
      "import": "./src/coaches.ts"
    },
    "./query-policy": {
      "types": "./src/query-policy.ts",
      "import": "./src/query-policy.ts"
    },
    "./commands": {
      "types": "./src/commands.ts",
      "import": "./src/commands.ts"
    },
    "./mentions": {
      "types": "./src/mentions.ts",
      "import": "./src/mentions.ts"
    },
    "./surfaces": {
      "types": "./src/surfaces.ts",
      "import": "./src/surfaces.ts"
    },
    "./notification-routing": {
      "types": "./src/notification-routing.ts",
      "import": "./src/notification-routing.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "generate": "node ../../scripts/sdk/generate-surface-capabilities.js"
  },
  "dependencies": {
    "@pierre/shared-types": "*"
  },
  "devDependencies": {
    "typescript": "~5.8.3"
  },
  "files": [
    "src"
  ],
  "sideEffects": false,
  "private": true
}
