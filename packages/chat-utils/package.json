{
  "name": "@pierre/chat-utils",
  "version": "1.0.0",
  "description": "Shared chat utility functions for Pierre frontend applications",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./activity": {
      "types": "./src/activity.ts",
      "import": "./src/activity.ts"
    },
    "./conversation": {
      "types": "./src/conversation.ts",
      "import": "./src/conversation.ts"
    },
    "./conversation-row": {
      "types": "./src/conversation-row.ts",
      "import": "./src/conversation-row.ts"
    },
    "./progress": {
      "types": "./src/progress.ts",
      "import": "./src/progress.ts"
    },
    "./blocks": {
      "types": "./src/blocks.ts",
      "import": "./src/blocks.ts"
    },
    "./action-url": {
      "types": "./src/action-url.ts",
      "import": "./src/action-url.ts"
    },
    "./quota": {
      "types": "./src/quota.ts",
      "import": "./src/quota.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@pierre/shared-types": "*"
  },
  "devDependencies": {
    "@pierre/shared-types": "*",
    "typescript": "~5.8.3",
    "vitest": "^4.1.8"
  },
  "files": [
    "src"
  ],
  "sideEffects": false,
  "private": true,
  "dependencies": {
    "@pierre/scene-types": "*"
