<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.dravr.cargo-sweep</string>

    <!-- The routine sweep: merged worktrees, the age pass (at most once a day on a
         scheduled run), then the cap and the free-space floor. The cap and the floor are
         passed explicitly rather than left to the script defaults so the schedule is
         fully described by this file. `status` reads it back and reports it, so a drift
         between the installed schedule and the script default is visible.
         `purge` is deliberately NOT scheduled: it drops incremental caches and whole
         idle trees, which costs the next build in every repo. Run it by hand when
         space is the actual goal. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__SCRIPT__</string>
        <string>sweep</string>
        <string>--scheduled</string>
        <string>--cap</string>
        <string>__CAP__</string>
        <string>--min-free</string>
        <string>__MIN_FREE__</string>
    </array>

    <!-- Hourly. Nightly let four agent worktrees fill the disk between 13:30 and 16:30
         on 2026-10-05 with nothing reacting; the floor needs to act within the hour.
         The slow age pass still runs about once a day: the script throttles it. -->
    <key>StartInterval</key>
    <integer>3600</integer>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__LOG__</string>
    <key>StandardErrorPath</key>
    <string>__LOG__</string>

    <!-- launchd starts with a minimal PATH. cargo, cargo-sweep, git and python3 must all
         resolve: cargo-sweep missing makes the run exit 127 by design, and python3 missing
         downgrades the build-lock probe from an exact flock(2) test to an mtime heuristic.
         /opt/homebrew/bin carries python3 on this machine; /usr/bin has a fallback. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__HOME__/.cargo/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>

    <!-- Stay out of the way of anything the machine is actually doing. -->
    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
    <key>Nice</key>
    <integer>5</integer>
</dict>
</plist>
