{
  "includeCoAuthoredBy": false,
  "attribution": { "commit": "", "pr": "" },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "if echo \"$TOOL_INPUT\" | grep -q 'frontend/src/components'; then echo '💡 Frontend component modified - consider running /design-review'; fi"
          }
        ]
      },
      {
        "matcher": "Artifact",
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "h=\"${CLAUDE_PROJECT_DIR:-.}/.claude/skills/slack-artifact/hooks/post-publish.sh\"; [ -f \"$h\" ] || exit 0; bash \"$h\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f .build/ci/bootstrap-repo.sh ] || { [ -e .build/.git ] && git -C .build symbolic-ref -q HEAD >/dev/null 2>&1; } || git submodule update --init --recursive -q 2>/dev/null; [ -f .build/ci/bootstrap-repo.sh ] && bash .build/ci/bootstrap-repo.sh || true"
          },
          {
            "type": "command",
            "command": "[ -f ../dravr-vault/scripts/sync-claude-memory.sh ] && bash ../dravr-vault/scripts/sync-claude-memory.sh --quiet || true"
          },
          {
            "type": "command",
            "command": "echo '✅ Pierre Design System ready - use /design-review for UI validation'"
          },
          {
            "type": "command",
            "command": "echo 'PORT ALLOCATION: 8081=Pierre Server, 8082=Expo/Metro. Use bun start for mobile dev.'"
          },
          {
            "type": "command",
            "command": "echo 'DEV ENVIRONMENT: When testing is needed, run ./bin/setup-db-with-seeds-and-oauth-and-start-servers.sh (debug build by default, --release for optimized builds). This resets the DB, seeds admin/coaches/demo/social/mobility/synthetic data, and starts Pierre (8081), Vite frontend (5173), and Expo (8082). Admin login: resolve $ADMIN_EMAIL from .envrc (the admin@example.com default returns invalid_grant locally; see AGENTS.md). Seeded users: webtest@pierre.dev/WebTest123!, mobiletest@pierre.dev/MobileTest1234, alice@acme.com/DemoUser123!. Admin token saved to logs/admin-token.txt. NEVER start the server without this script when login or user data is needed.'"
          },
          {
            "type": "command",
            "command": "bash ./scripts/setup/check-gh-cli.sh"
          },
          {
            "type": "command",
            "command": "bash ./scripts/setup/check-mcp-tokens.sh"
          },
          {
            "type": "command",
            "timeout": 20,
            "command": "[ -f .build/ci/savoir.sh ] && SAVOIR_LOCK_WAIT=10 bash .build/ci/savoir.sh sync >/dev/null 2>&1; [ -f .claude/skills/bilan/hooks/session-start-sweep.sh ] && bash .claude/skills/bilan/hooks/session-start-sweep.sh || true"
          },
          {
            "type": "command",
            "timeout": 60,
            "command": "[ -f scripts/setup/cargo-sweep-nightly.sh ] && bash scripts/setup/cargo-sweep-nightly.sh check || true"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "timeout": 20,
            "command": "[ -f .claude/skills/bilan/hooks/post-compact-state.sh ] && bash .claude/skills/bilan/hooks/post-compact-state.sh || true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "timeout": 20,
            "command": "[ -f .claude/skills/carnet/hooks/prompt-status.sh ] && bash .claude/skills/carnet/hooks/prompt-status.sh || true"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "[ -f .claude/skills/carnet/hooks/session-end-release.sh ] && bash .claude/skills/carnet/hooks/session-end-release.sh || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "timeout": 20,
            "command": "[ -f .claude/skills/carnet/hooks/auto-claim.sh ] || exit 0; bash .claude/skills/carnet/hooks/auto-claim.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "[ -f scripts/setup/cargo-sweep-nightly.sh ] || exit 0; bash scripts/setup/cargo-sweep-nightly.sh guard"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": []
  }
}
