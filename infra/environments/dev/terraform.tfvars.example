# ABOUTME: Example Terraform variables for the development environment
# ABOUTME: Copy to terraform.tfvars and fill in real values before applying

# -----------------------------------------------------------------------------
# Required Variables (no defaults)
# -----------------------------------------------------------------------------

# GCP project ID for the dev environment (required)
project_id = "dravr-dev"

# Container image for the backend API (required)
backend_image = "northamerica-northeast1-docker.pkg.dev/dravr-artifacts/dravr-images/server:latest"

# GCP project ID of the centralized dravr-artifacts project (required)
artifacts_project_id = "dravr-artifacts"

# -----------------------------------------------------------------------------
# Private inputs (no defaults)
# -----------------------------------------------------------------------------
# Account ids, addresses, account names and limits have no default and no value
# in the committed terraform.tfvars. The real values live in a private var-file
# that infra/private-inputs.sh stages as private.auto.tfvars, which terraform
# loads after terraform.tfvars. Every value below is a placeholder showing the
# shape; none is real. The alert_thresholds and alert_windows maps declared in
# private_inputs.tf come from the same file.

billing_account_id     = "000000-000000-000000"
monthly_budget_amount  = 100
budget_alert_fractions = [0.5, 1]

firebase_project_id = "example-firebase-project"

admin_email       = "admin@example.com"
resend_from_email = "no-reply@example.com"

slack_error_channel         = "#example-alerts"
notify_batch_window_secs    = 1
notify_max_messages_per_min = 1
notify_dedup_window_secs    = 1
notify_email_from           = "Example Alerts <alerts@example.com>"
notify_email_to             = "oncall@example.com"

llm_chain = "example_provider=example-model,example_provider#2=example-model"

strava_oauth_seat_cap         = 1
meta_whatsapp_phone_number_id = "000000000000000"
meta_whatsapp_verify_token    = "example-verify-token"
meta_messenger_verify_token   = "example-verify-token"

# RFC 5737 documentation ranges, not real ones.
marketplace_egress_cidrs = ["198.51.100.0/24", "203.0.113.0/24"]

# -----------------------------------------------------------------------------
# Optional Variables (defaults shown, uncomment to override)
# -----------------------------------------------------------------------------

# environment  = "development"
# region       = "northamerica-northeast1"
# service_name = "dravr-mcp-server"

# -----------------------------------------------------------------------------
# Feature Toggles
# -----------------------------------------------------------------------------

# enable_database = false
# enable_cache    = false
# enable_frontend = true

# -----------------------------------------------------------------------------
# Backend Cloud Run
# -----------------------------------------------------------------------------

# backend_cpu           = "1"
# backend_memory        = "512Mi"
# backend_min_instances = 0
# backend_max_instances = 1

# -----------------------------------------------------------------------------
# Database (Cloud SQL) — only used when enable_database = true
# -----------------------------------------------------------------------------

# database_tier                = "db-f1-micro"
# database_deletion_protection = false
# database_backup_enabled      = false
# database_backup_start_time   = "03:00"

# -----------------------------------------------------------------------------
# Cache (Memorystore Redis) — only used when enable_cache = true
# -----------------------------------------------------------------------------

# redis_tier           = "BASIC"
# redis_memory_size_gb = 1
# redis_version        = "REDIS_7_0"

# -----------------------------------------------------------------------------
# Frontend Cloud Run — only used when enable_frontend = true
# -----------------------------------------------------------------------------

# frontend_min_instances = 0
# frontend_max_instances = 5

# First-party hostnames served by a global external load balancer in front of
# the frontend service (each gets a Google-managed certificate). Empty = the
# run.app hostname only.
# public_domains = ["app.dravr.ai", "mcp.dravr.ai"]
# Previous frontend origins still accepted during a hostname move (empty once done).
# frontend_previous_origins = []

# -----------------------------------------------------------------------------
# Labels
# -----------------------------------------------------------------------------

# labels = {
#   app         = "dravr"
#   managed_by  = "terraform"
#   environment = "development"
# }
