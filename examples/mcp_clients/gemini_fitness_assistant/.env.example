# Gemini Fitness Assistant - Environment Configuration
#
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env

# ============================================================================
# Gemini API Configuration (REQUIRED)
# ============================================================================
# Get your free API key at: https://ai.google.dev/gemini-api/docs/api-key
# Free tier: 1,500 requests/day, no credit card required
GEMINI_API_KEY=your-gemini-api-key-here

# ============================================================================
# Pierre Server Configuration (REQUIRED)
# ============================================================================
# Pierre server base URL
PIERRE_SERVER_URL=http://localhost:8081

# Pierre API key for this client. Create one in the Pierre web app
# (Settings → API keys). Pierre's password sign-in serves its own apps only.
PIERRE_API_KEY=your-pierre-api-key-here

# ============================================================================
# Optional Configuration
# ============================================================================
# Enable debug logging (default: false)
# DEBUG=true

# Request timeout in seconds (default: 30)
# REQUEST_TIMEOUT=30
