{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@pierre/shared-types": ["../packages/shared-types/src"],
      "@pierre/shared-constants": ["../packages/shared-constants/src"],
      "@pierre/i18n": ["../packages/i18n/src/index.ts"],
      "@pierre/i18n/native": ["../packages/i18n/src/native.ts"]
    },
    "types": ["jest", "node", "react-native", "expo/types/global"]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "nativewind-env.d.ts"
  ]
}
