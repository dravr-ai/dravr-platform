{
  "cli": {
    "version": ">= 24.4.2",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "22.23.1",
      "bun": "1.3.4",
      "ios": {
        "image": "macos-tahoe-26.5-xcode-26.6",
        "simulator": true
      },
      "environment": "development",
      "channel": "development"
    },
    "development-device": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "22.23.1",
      "bun": "1.3.4",
      "ios": {
        "image": "macos-tahoe-26.5-xcode-26.6",
        "resourceClass": "medium"
      },
      "environment": "development",
      "channel": "development"
    },
    "preview": {
      "autoIncrement": true,
      "distribution": "internal",
      "node": "22.23.1",
      "bun": "1.3.4",
      "ios": {
        "image": "macos-tahoe-26.5-xcode-26.6",
        "resourceClass": "medium"
      },
      "android": {
        "buildType": "apk"
      },
      "environment": "preview",
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "node": "22.23.1",
      "bun": "1.3.4",
      "ios": {
        "image": "macos-tahoe-26.5-xcode-26.6",
        "resourceClass": "medium"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "environment": "production",
      "channel": "production"
    }
  },
  "submit": {
    "preview": {
      "extends": "production"
    },
    "production": {
      "ios": {
        "ascAppId": "6803245011"
      },
      "android": {
        "serviceAccountKeyPath": "${GOOGLE_SERVICE_ACCOUNT_KEY_PATH}",
        "track": "internal"
      }
    }
  }
}
