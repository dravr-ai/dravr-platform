{
  "manifest_version": 3,
  "name": "Dravr sign-in",
  "version": "0.1.0",
  "description": "Signs you in to Garmin, Strava, TrainingPeaks or COROS in your own browser and hands that session to Dravr.",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "minimum_chrome_version": "116",
  "browser_specific_settings": {
    "gecko": {
      "id": "dravr-signin@dravr.ai",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo"
        ]
      }
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.dravr.ai/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "cookies",
    "tabs"
  ],
  "host_permissions": [
    "https://*.garmin.com/*",
    "https://*.strava.com/*",
    "https://*.trainingpeaks.com/*",
    "https://*.coros.com/*",
    "https://app.dravr.ai/*"
  ]
}
