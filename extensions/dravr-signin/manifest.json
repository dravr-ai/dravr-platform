{
  "manifest_version": 3,
  "name": "Dravr sign-in",
  "version": "0.1.0",
  "description": "Signs you in to Garmin, Strava, TrainingPeaks or COROS in your own browser and hands that session to Dravr.",
  "key": "",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "cookies",
    "tabs"
  ],
  "host_permissions": [
    "https://*.garmin.com/*",
    "https://*.strava.com/*",
    "https://*.trainingpeaks.com/*",
    "https://*.coros.com/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://app.dravr.ai/*"
    ]
  }
}
