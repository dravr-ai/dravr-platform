# Supabase
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site URL — used for OAuth redirect_to / emailRedirectTo
# Must match one of the allowlisted redirect URLs in Supabase Auth dashboard.
PUBLIC_SITE_URL=http://localhost:4321

# Feature flags
PUBLIC_GOOGLE_AUTH_ENABLED=false

# Cloudflare Turnstile — bot protection on the waitlist form
# Test keys below ALWAYS pass the challenge and are safe for local dev.
# In Cloudflare dashboard → Turnstile → Add site to get real production keys.
# See SETUP.md for the full walkthrough.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
