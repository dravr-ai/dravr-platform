---
// ABOUTME: French version of the alpha portal login (/fr/docs/login)
// ABOUTME: URL /fr/docs/login causes getLangFromUrl to return 'fr'; all copy renders in French
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import LanguagePicker from '../../../components/LanguagePicker.astro';
import borealRiver from '../../../assets/images/boreal-river.jpg';
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';
import { isFlagEnabled } from '../../../lib/flags';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const reason = Astro.url.searchParams.get('reason');
const googleEnabled = isFlagEnabled(import.meta.env.PUBLIC_GOOGLE_AUTH_ENABLED);
---

<Base title={t('login.title')} noNav noFooter>

  <div class="bg-surface font-body text-on-surface min-h-screen flex flex-col items-center justify-center overflow-hidden">

    <!-- Background Layer with Boreal Image -->
    <div class="fixed inset-0 z-0">
      <Image
        alt={t('login.img.alt')}
        class="w-full h-full object-cover"
        src={borealRiver}
        widths={[640, 1024, 1920, 2560]}
        sizes="100vw"
        format="webp"
        loading="eager"
        fetchpriority="high"
      />
      <div class="boreal-hero-gradient absolute inset-0 z-10"></div>
    </div>

    <!-- Main Content Canvas -->
    <main class="relative z-10 w-full max-w-md px-6 py-12">

      <!-- Header / Identity -->
      <div class="text-center mb-10">
        <h1 class="font-headline text-2xl tracking-[0.25em] font-bold uppercase mb-2 text-white/95">{t('login.title')}</h1>
        <p class="font-label text-[0.6875rem] tracking-[0.1em] uppercase text-primary-fixed-dim/80">{t('login.subtitle')}</p>
      </div>

      <!-- Glassmorphic Login Card -->
      <div class="boreal-glass p-10 rounded-xl shadow-[0_24px_48px_-12px_rgba(26,28,27,0.06)] border border-outline-variant/15">

        <div class="mb-8">
          <h2 class="font-headline text-xl font-medium text-primary tracking-tight mb-1">{t('login.card.title')}</h2>
          <p class="font-body text-sm text-on-surface-variant/80">{t('login.card.desc')}</p>
        </div>

        {reason === 'not-approved' && (
          <div class="mb-6 p-4 rounded-lg bg-primary/5 border border-outline-variant/20">
            <p class="text-xs font-label text-on-surface-variant/70">
              {t('login.waitlist')}
            </p>
          </div>
        )}

        <form id="login-form" class="space-y-8">

          <div class="relative">
            <label class="font-label text-[0.6875rem] uppercase tracking-widest text-on-surface-variant/60 block mb-2" for="login-email">
              {t('login.email.label')}
            </label>
            <div class="flex items-center group">
              <span class="material-symbols-outlined text-primary/40 mr-3 text-lg">vpn_key</span>
              <input
                id="login-email"
                name="email"
                type="email"
                required
                placeholder={t('login.email.placeholder')}
                class="w-full bg-transparent border-0 border-b border-outline-variant/40 py-2 focus:ring-0 focus:border-b-2 focus:border-primary transition-all text-on-surface placeholder:text-outline-variant/60 font-body"
              />
            </div>
          </div>

          <div id="login-status" class="hidden text-sm font-label"></div>

          <button
            type="submit"
            class="w-full bg-primary text-on-primary py-4 rounded-lg font-headline font-semibold tracking-widest text-sm uppercase hover:opacity-90 active:scale-[0.98] transition-all flex justify-center items-center gap-2 group shadow-lg shadow-primary/10"
          >
            {t('login.submit')}
            <span class="material-symbols-outlined text-sm group-hover:translate-x-1 transition-transform">arrow_forward</span>
          </button>

        </form>

        {googleEnabled && (
          <>
            <!-- "Or" divider — negative space only, per DESIGN.md: no 1px solid sectioning rules -->
            <div class="mt-10 mb-6 flex justify-center">
              <span class="font-label text-[0.6875rem] uppercase tracking-widest text-on-surface-variant/40">
                {t('login.or')}
              </span>
            </div>

            <!-- Google Sign-In -->
            <button
              id="google-btn"
              type="button"
              class="w-full border border-outline-variant/30 text-on-surface py-3 rounded-lg font-label text-sm tracking-wide hover:bg-surface-variant/20 active:scale-[0.98] transition-all flex justify-center items-center gap-3"
            >
              <svg width="18" height="18" viewBox="0 0 18 18" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.716v2.259h2.908c1.702-1.567 2.684-3.875 2.684-6.615z" fill="#4285F4"/>
                <path d="M9 18c2.43 0 4.467-.806 5.956-2.18l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332C2.438 15.983 5.482 18 9 18z" fill="#34A853"/>
                <path d="M3.964 10.71c-.18-.54-.282-1.117-.282-1.71s.102-1.17.282-1.71V4.958H.957C.347 6.173 0 7.548 0 9s.348 2.827.957 4.042l3.007-2.332z" fill="#FBBC05"/>
                <path d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0 5.482 0 2.438 2.017.957 4.958L3.964 7.29C4.672 5.163 6.656 3.58 9 3.58z" fill="#EA4335"/>
              </svg>
              {t('login.google')}
            </button>
          </>
        )}

        <!-- Technical Trust Indicators -->
        <div class="mt-10 pt-8 border-t border-outline-variant/15">
          <div class="flex justify-between items-center text-[0.625rem] font-label text-on-surface-variant/50 uppercase tracking-widest">
            <div class="flex items-center gap-1.5">
              <span class="material-symbols-outlined text-[10px]" style="font-variation-settings: 'FILL' 1;">verified_user</span>
              {t('login.trust.encrypted')}
            </div>
            <div class="flex items-center gap-1.5">
              <span class="material-symbols-outlined text-[10px]" style="font-variation-settings: 'FILL' 1;">terminal</span>
              {t('login.trust.terminal')}
            </div>
            <div class="flex items-center gap-1.5">
              <span class="material-symbols-outlined text-[10px]" style="font-variation-settings: 'FILL' 1;">hub</span>
              {t('login.trust.version')}
            </div>
          </div>
        </div>

      </div>

      <!-- Secondary Navigation / Support -->
      <div class="mt-8 flex justify-between px-2 font-label text-[0.6875rem] uppercase tracking-wider text-white/70">
        <a class="hover:text-primary-fixed-dim transition-colors hover:underline underline-offset-4" href="/fr/#waitlist">{t('login.request')}</a>
        <div class="flex items-center gap-4">
          <LanguagePicker />
          <a class="hover:text-primary-fixed-dim transition-colors hover:underline underline-offset-4" href="/fr/">{t('login.back')}</a>
        </div>
      </div>

    </main>

    <!-- Footer Area -->
    <footer class="fixed bottom-0 w-full z-10 p-10 bg-transparent flex flex-col md:flex-row justify-between items-center gap-4">
      <div class="font-headline text-[0.625rem] tracking-[0.2em] font-bold uppercase text-white/40">
        {t('login.footer.node')}
      </div>
      <div class="font-label text-[0.625rem] tracking-widest uppercase text-white/30">
        {t('login.footer.rights')}
      </div>
    </footer>

  </div>

</Base>

<script>
  import { createBrowserClient } from '../../../lib/supabase';

  const form = document.getElementById('login-form');
  const statusEl = document.getElementById('login-status');

  const pageEl = document.querySelector('[data-i18n-sending]');
  const textSending = pageEl?.getAttribute('data-i18n-sending') ?? 'Envoi du lien…';
  const textError = pageEl?.getAttribute('data-i18n-error') ?? 'Impossible d\'envoyer le lien. Réessayez dans un moment.';
  const textCheck = pageEl?.getAttribute('data-i18n-check') ?? 'Vérifiez votre courriel — le lien magique expire dans 10 minutes.';
  const textSent = pageEl?.getAttribute('data-i18n-sent') ?? 'Lien envoyé ✓';

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = form.elements.namedItem('email').value.trim();
    const btn = form.querySelector('button[type="submit"]');

    btn.disabled = true;
    btn.innerHTML = `<span class="font-headline tracking-widest">${textSending}</span>`;

    const siteUrl = import.meta.env.PUBLIC_SITE_URL || window.location.origin;
    // The callback route lives only at /docs/auth/callback — there is no
    // /fr/docs/auth/callback. The `lang=fr` query param tells the callback
    // handler which locale to redirect back to after the code exchange.
    const supabase = createBrowserClient();
    const { error } = await supabase.auth.signInWithOtp({
      email,
      options: {
        emailRedirectTo: `${siteUrl}/docs/auth/callback?lang=fr`,
      },
    });

    if (statusEl) {
      statusEl.classList.remove('hidden');
      if (error) {
        statusEl.textContent = textError;
        statusEl.className = 'text-sm font-label text-error';
        btn.disabled = false;
        btn.innerHTML = `
          ${textSending.replace('…', '')}
          <span class="material-symbols-outlined text-sm group-hover:translate-x-1 transition-transform">arrow_forward</span>
        `;
      } else {
        statusEl.textContent = textCheck;
        statusEl.className = 'text-sm font-label text-on-surface-variant';
        btn.textContent = textSent;
      }
    }
  });

  const googleBtn = document.getElementById('google-btn');
  googleBtn?.addEventListener('click', async () => {
    (googleBtn as HTMLButtonElement).disabled = true;
    const lang = window.location.pathname.startsWith('/fr') ? 'fr' : 'en';
    const siteUrl = import.meta.env.PUBLIC_SITE_URL || window.location.origin;
    const supabase = createBrowserClient();
    await supabase.auth.signInWithOAuth({
      provider: 'google',
      options: {
        redirectTo: `${siteUrl}/docs/auth/callback?lang=${lang}`,
      },
    });
  });
</script>

<!-- Hidden element carrying translated messages for client-side JS -->
<div
  hidden
  data-i18n-sending={t('login.sending')}
  data-i18n-error={t('login.error.send')}
  data-i18n-check={t('login.check.email')}
  data-i18n-sent={t('login.sent')}
></div>
