---
// ABOUTME: Dravr marketing home page — full-screen boreal river hero, waitlist CTA
// ABOUTME: Faithfully implements the Stitch home screen design (project 1685995167983782189)
export const prerender = true;

import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import LanguagePicker from '../components/LanguagePicker.astro';
import borealRiver from '../assets/images/boreal-river.jpg';
import { getLangFromUrl, useTranslations, getDocsBasePath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const docsBase = getDocsBasePath(lang);
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<Base title="Dravr" description={t('home.tagline')} noNav noFooter>

  <script slot="head" src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

  <!-- Main Canvas -->
  <div class="relative min-h-screen w-full flex flex-col justify-center items-center overflow-hidden bg-primary font-body text-on-surface selection:bg-primary-fixed-dim selection:text-primary-container">

    <!-- Atmospheric Background Layer -->
    <div class="absolute inset-0 z-0">
      <Image
        alt={t('home.img.alt')}
        class="w-full h-full object-cover"
        src={borealRiver}
        widths={[640, 1024, 1920, 2560]}
        sizes="100vw"
        format="webp"
        loading="eager"
        fetchpriority="high"
      />
      <div class="boreal-hero-gradient absolute inset-0 z-10"></div>
    </div>

    <!-- Hero Content Section -->
    <section id="waitlist" class="relative z-20 w-full max-w-7xl px-8 flex flex-col items-center text-center">

      <!-- Brand Anchor -->
      <div class="mb-12">
        <h1 class="font-headline text-6xl md:text-9xl font-bold tracking-[0.2em] uppercase text-white/95 text-glow">
          DRAVR
        </h1>
        <p class="font-label text-xs md:text-sm tracking-[0.4em] uppercase text-primary-fixed-dim/80 mt-4">
          {t('home.tagline')}
        </p>
      </div>

      <!-- Minimal Sign-up Flow -->
      <div class="w-full max-w-md space-y-12">
        <div class="space-y-4">
          <h2 class="font-headline text-3xl text-white font-light tracking-tight">
            {t('home.hero')}
          </h2>
          <p class="text-white/70 font-body text-sm leading-relaxed max-w-xs mx-auto">
            {t('home.body')}
          </p>
        </div>

        <form id="waitlist-form" class="flex flex-col gap-6">
          <div class="relative group">
            <input
              id="waitlist-email"
              name="email"
              type="email"
              required
              placeholder={t('home.email.placeholder')}
              class="w-full bg-transparent border-b border-outline-variant/40 text-white py-3 px-1 focus:outline-none focus:border-b-2 focus:border-primary transition-all duration-500 placeholder:text-white/30 font-body"
            />
            <div class="absolute bottom-0 left-0 w-0 h-[2px] bg-primary transition-all duration-500 group-focus-within:w-full"></div>
          </div>

          <div
            class="cf-turnstile flex justify-center"
            data-sitekey={turnstileSiteKey}
            data-theme="dark"
            data-size="flexible"
            data-appearance="interaction-only"
          ></div>

          <div id="waitlist-status" class="hidden text-sm font-label text-center"></div>

          <button
            type="submit"
            class="group flex items-center justify-center gap-3 text-white font-headline tracking-widest text-sm uppercase transition-all duration-300"
          >
            <span class="border-b border-transparent group-hover:border-white pb-1">{t('home.cta')}</span>
            <span class="material-symbols-outlined text-sm">arrow_forward</span>
          </button>
        </form>
      </div>

    </section>

    <!-- Bottom-right Boreal Status Card -->
    <div class="absolute bottom-32 right-8 md:right-24 z-20 hidden lg:block">
      <div class="boreal-overlay p-6 rounded-lg text-white max-w-[280px]">
        <div class="flex items-center gap-4 mb-4">
          <span class="material-symbols-outlined text-primary-fixed-dim">monitoring</span>
          <span class="font-label text-[0.6875rem] tracking-[0.1em] uppercase text-primary-fixed-dim">{t('home.status.label')}</span>
        </div>
        <div class="space-y-3">
          <div class="flex justify-between items-end">
            <span class="font-label text-[0.6rem] text-white/40 uppercase">{t('home.status.phase')}</span>
            <span class="font-headline text-xl text-white">{t('home.status.title')}</span>
          </div>
          <div class="h-[1px] w-full bg-white/10"></div>
          <p class="text-[0.75rem] text-white/60 leading-relaxed font-body">
            {t('home.status.desc')}
          </p>
        </div>
      </div>
    </div>

  </div>

  <!-- Footer (outside main via named slot) -->
  <footer slot="after-main" class="fixed bottom-0 left-0 w-full z-30 py-8 bg-transparent">
    <div class="max-w-7xl mx-auto px-8 flex flex-col md:flex-row justify-between items-center gap-4">
      <div class="text-2xl font-bold tracking-[0.15em] uppercase text-white/90 font-headline">
        DRAVR
      </div>
      <nav class="flex gap-8">
        <a class="text-white/60 font-label text-[0.6875rem] tracking-[0.05em] uppercase hover:text-white transition-colors duration-300" href="#">{t('footer.privacy')}</a>
        <a class="text-white/60 font-label text-[0.6875rem] tracking-[0.05em] uppercase hover:text-white transition-colors duration-300" href="#">{t('footer.terms')}</a>
        <a class="text-white/60 font-label text-[0.6875rem] tracking-[0.05em] uppercase hover:text-white transition-colors duration-300" href={`${docsBase}/login`}>{t('footer.docs')}</a>
      </nav>
      <div class="flex items-center gap-6">
        <LanguagePicker />
        <div class="text-white/40 font-label text-[0.6875rem] tracking-[0.05em] uppercase">
          {t('footer.rights')}
        </div>
      </div>
    </div>
  </footer>

</Base>

<script>
  const form = document.getElementById('waitlist-form');
  const status = document.getElementById('waitlist-status');

  // Read translated messages from data attributes set server-side
  const pageEl = document.querySelector('[data-i18n-success]');
  const successText = pageEl?.getAttribute('data-i18n-success') ?? "You're on the list. We'll reach out soon.";
  const errorText = pageEl?.getAttribute('data-i18n-error') ?? 'Something went wrong. Try again.';

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = form.elements.namedItem('email').value;
    const btn = form.querySelector('button[type="submit"]');
    const turnstileInput = form.querySelector('[name="cf-turnstile-response"]');
    const turnstileToken = turnstileInput instanceof HTMLInputElement ? turnstileInput.value : '';

    btn.disabled = true;

    try {
      const res = await fetch('/api/waitlist', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, turnstileToken }),
      });
      const data = await res.json();

      if (status) {
        status.classList.remove('hidden');
        if (data.success) {
          status.textContent = successText;
          status.className = 'text-sm font-label text-primary-fixed-dim';
          form.reset();
        } else {
          status.textContent = errorText;
          status.className = 'text-sm font-label text-red-300';
          btn.disabled = false;
        }
      }
    } catch {
      if (status) {
        status.classList.remove('hidden');
        status.textContent = errorText;
        status.className = 'text-sm font-label text-red-300';
      }
      btn.disabled = false;
    }
  });
</script>

<!-- Hidden element carrying translated messages for client-side JS -->
<div
  hidden
  data-i18n-success={t('home.success')}
  data-i18n-error={t('home.error')}
></div>
