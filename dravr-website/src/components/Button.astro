---
// ABOUTME: Reusable button component for the Dravr website
// ABOUTME: Three variants matching the Boreal Editorial design system

interface Props {
  variant?: 'primary' | 'secondary' | 'ghost';
  href?: string;
  type?: 'button' | 'submit';
  class?: string;
}

const { variant = 'primary', href, type = 'button', class: className = '' } = Astro.props;

// DESIGN.md §5:
// - Primary button hover → subtle inner glow at 10% surface_tint (#3c6658), same bg
// - Secondary button hover → underline expands from the center (custom pseudo-element)
const base = 'inline-flex items-center justify-center font-medium transition-all rounded-md text-sm';

const variants = {
  primary: 'bg-primary text-on-primary px-5 py-2.5 hover:shadow-[inset_0_0_12px_rgba(60,102,88,0.1)]',
  secondary: 'btn-secondary text-primary px-2 py-1',
  ghost: 'border border-outline-variant/40 text-on-surface px-5 py-2.5 hover:bg-surface-container-high',
};

const classes = `${base} ${variants[variant]} ${className}`;
---

{href ? (
  <a href={href} class={classes}>
    <slot />
  </a>
) : (
  <button type={type} class={classes}>
    <slot />
  </button>
)}
